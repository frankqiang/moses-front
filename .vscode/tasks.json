{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESLint: Fix All",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:fix"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Prettier: Format All",
      "type": "shell",
      "command": "npm",
      "args": ["run", "prettier:fix"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Lint and Format All",
      "dependsOrder": "sequence",
      "dependsOn": ["ESLint: Fix All", "Prettier: Format All"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
