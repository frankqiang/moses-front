### 数据验证和规范化
```javascript
// mock/utils/generator.js
const Mock = require('mockjs')

/**
 * 生成符合规范的编码
 * @param {string} prefix - 前缀
 * @param {number} length - 数字部分长度
 * @returns {string} 规范化编码
 */
const generateCode = (prefix, length = 3) => {
  const number = Mock.mock(`@integer(1, ${Math.pow(10, length) - 1})`)
  return `${prefix}-${String(number).padStart(length, '0')}`
}

/**
 * 生成合理的时间范围
 * @param {Date} baseDate - 基准日期
 * @param {number} daysBefore - 向前天数
 * @param {number} daysAfter - 向后天数
 * @returns {Object} 时间范围对象
 */
const generateTimeRange = (baseDate = new Date(), daysBefore = 30, daysAfter = 30) => {
  const base = new Date(baseDate)
  const startTime = new Date(base.getTime() - daysBefore * 24 * 60 * 60 * 1000)
  const endTime = new Date(base.getTime() + daysAfter * 24 * 60 * 60 * 1000)
  
  return {
    start: startTime.toISOString().slice(0, 19).replace('T', ' '),
    end: endTime.toISOString().slice(0, 19).replace('T', ' ')
  }
}

/**
 * 生成符合业务规则的状态流转
 * @param {string} currentStatus - 当前状态
 * @param {Object} stateRules - 状态转换规则
 * @returns {string} 下一个可能状态
 */
const generateNextStatus = (currentStatus, stateRules) => {
  const allowedNext = stateRules[currentStatus] || []
  if (allowedNext.length === 0) return currentStatus
  
  const randomIndex = Math.floor(Math.random() * allowedNext.length)
  return allowedNext[randomIndex]
}

module.exports = {
  generateCode,
  generateTimeRange,
  generateNextStatus
}
```

## API处理函数设计

### 标准API处理结构
每个API处理文件应遵循以下结构：

```javascript
// mock/modules/master-data/equipment.js
const { data: equipmentData } = require('./data/equipment')
const { success, error, paginate } = require('../../utils/response')

// 数据缓存和状态管理
let dataCache = [...equipmentData]
let idCounter = Math.max(...dataCache.map(item => item.id)) + 1

// 业务状态转换规则
const statusRules = {
  'idle': ['running', 'maintenance'],
  'running': ['idle', 'fault'],
  'maintenance': ['idle'],
  'fault': ['maintenance', 'idle']
}

/**
 * API处理函数集合
 */
const handlers = {
  /**
   * 获取设备列表
   * @param {Object} config - 请求配置
   * @returns {Object} 响应数据
   */
  getList(config) {
    const { 
      page = 1, 
      limit = 10, 
      keyword = '', 
      status = '', 
      category = '',
      workshop = ''
    } = config.query
    
    let filteredData = [...dataCache]
    
    // 关键词搜索
    if (keyword) {
      filteredData = filteredData.filter(item => 
        item.name.includes(keyword) || 
        item.code.includes(keyword) ||
        item.model.includes(keyword)
      )
    }
    
    // 状态过滤
    if (status) {
      filteredData = filteredData.filter(item => item.status === status)
    }
    
    // 分类过滤
    if (category) {
      filteredData = filteredData.filter(item => item.category === category)
    }
    
    // 车间过滤
    if (workshop) {
      filteredData = filteredData.filter(item => item.workshop === workshop)
    }
    
    // 分页处理
    const paginatedResult = paginate(filteredData, page, limit)
    
    return success({
      items: paginatedResult.items,
      total: filteredData.length,
      page: parseInt(page),
      limit: parseInt(limit),
      hasNext: paginatedResult.hasNext,
      hasPrev: paginatedResult.hasPrev
    }, '获取设备列表成功')
  },

  /**
   * 获取设备详情
   * @param {Object} config - 请求配置
   * @returns {Object} 响应数据
   */
  getDetail(config) {
    const { id } = config.query
    const equipment = dataCache.find(item => item.id == id)
    
    if (!equipment) {
      return error('EQUIPMENT_NOT_FOUND', '设备不存在', 404)
    }
    
    return success(equipment, '获取设备详情成功')
  },

  /**
   * 创建设备
   * @param {Object} config - 请求配置
   * @returns {Object} 响应数据
   */
  create(config) {
    const equipmentData = config.body
    
    // 基础验证
    if (!equipmentData.name || !equipmentData.code) {
      return error('VALIDATION_ERROR', '设备名称和编码不能为空', 422)
    }
    
    // 检查编码唯一性
    const existingEquipment = dataCache.find(item => item.code === equipmentData.code)
    if (existingEquipment) {
      return error('EQUIPMENT_CODE_EXISTS', '设备编码已存在', 422)
    }
    
    // 创建新设备
    const newEquipment = {
      id: idCounter++,
      ...equipmentData,
      status: equipmentData.status || 'idle',
      createdAt: new Date().toISOString().slice(0, 19).replace('T', ' '),
      updatedAt: new Date().toISOString().slice(0, 19).replace('T', ' ')
    }
    
    dataCache.push(newEquipment)
    
    return success(newEquipment, '设备创建成功', 201)
  },

  /**
   * 更新设备
   * @param {Object} config - 请求配置
   * @returns {Object} 响应数据
   */
  update(config) {
    const { id } = config.query
    const updateData = config.body
    
    const equipmentIndex = dataCache.findIndex(item => item.id == id)
    if (equipmentIndex === -1) {
      return error('EQUIPMENT_NOT_FOUND', '设备不存在', 404)
    }
    
    // 验证状态转换
    const currentEquipment = dataCache[equipmentIndex]
    if (updateData.status && updateData.status !== currentEquipment.status) {
      const allowedStatuses = statusRules[currentEquipment.status] || []
      if (!allowedStatuses.includes(updateData.status)) {
        return error('INVALID_STATUS_TRANSITION', 
          `不能从${currentEquipment.status}状态转换到${updateData.status}状态`, 422)
      }
    }
    
    // 更新设备信息
    const updatedEquipment = {
      ...currentEquipment,
      ...updateData,
      id: currentEquipment.id, // 保持ID不变
      updatedAt: new Date().toISOString().slice(0, 19).replace('T', ' ')
    }
    
    dataCache[equipmentIndex] = updatedEquipment
    
    return success(updatedEquipment, '设备更新成功')
  },

  /**
   * 删除设备
   * @param {Object} config - 请求配置
   * @returns {Object} 响应数据
   */
  delete(config) {
    const { id } = config.query
    const equipmentIndex = dataCache.findIndex(item => item.id == id)
    
    if (equipmentIndex === -1) {
      return error('EQUIPMENT_NOT_FOUND', '设备不存在', 404)
    }
    
    // 检查设备状态，运行中的设备不能删除
    const equipment = dataCache[equipmentIndex]
    if (equipment.status === 'running') {
      return error('EQUIPMENT_IN_USE', '运行中的设备不能删除', 422)
    }
    
    dataCache.splice(equipmentIndex, 1)
    
    return success(null, '设备删除成功', 204)
  },

  /**
   * 批量更新设备状态
   * @param {Object} config - 请求配置
   * @returns {Object} 响应数据
   */
  batchUpdateStatus(config) {
    const { ids, status } = config.body
    
    if (!ids || !Array.isArray(ids) || ids.length === 0) {
      return error('VALIDATION_ERROR', '设备ID列表不能为空', 422)
    }
    
    const validStatuses = ['idle', 'running', 'maintenance', 'fault']
    if (!validStatuses.includes(status)) {
      return error('VALIDATION_ERROR', '无效的设备状态', 422)
    }
    
    const updatedEquipments = []
    const errors = []
    
    ids.forEach(id => {
      const equipmentIndex = dataCache.findIndex(item => item.id == id)
      if (equipmentIndex === -1) {
        errors.push({ id, message: '设备不存在' })
        return
      }
      
      const equipment = dataCache[equipmentIndex]
      const allowedStatuses = statusRules[equipment.status] || []
      
      if (!allowedStatuses.includes(status)) {
        errors.push({ 
          id, 
          message: `不能从${equipment.status}状态转换到${status}状态` 
        })
        return
      }
      
      const updatedEquipment = {
        ...equipment,
        status,
        updatedAt: new Date().toISOString().slice(0, 19).replace('T', ' ')
      }
      
      dataCache[equipmentIndex] = updatedEquipment
      updatedEquipments.push(updatedEquipment)
    })
    
    return success({
      updated: updatedEquipments,
      errors: errors,
      summary: {
        total: ids.length,
        success: updatedEquipments.length,
        failed: errors.length
      }
    }, '批量更新完成')
  }
}

/**
 * 导出Mock路由配置
 */
module.exports = [
  {
    url: '/mes/master-data/equipment/list',
    type: 'get',
    response: handlers.getList
  },
  {
    url: '/mes/master-data/equipment/detail',
    type: 'get', 
    response: handlers.getDetail
  },
  {
    url: '/mes/master-data/equipment',
    type: 'post',
    response: handlers.create
  },
  {
    url: '/mes/master-data/equipment',
    type: 'put',
    response: handlers.update
  },
  {
    url: '/mes/master-data/equipment',
    type: 'delete',
    response: handlers.delete
  },
  {
    url: '/mes/master-data/equipment/batch-status',
    type: 'post',
    response: handlers.batchUpdateStatus
  }
]
```

## 响应工具与格式规范

### 统一响应工具
```javascript
// mock/utils/response.js

/**
 * 成功响应
 * @param {*} data - 响应数据
 * @param {string} message - 响应消息
 * @param {number} status - HTTP状态码
 * @returns {Object} 标准响应格式
 */
const success = (data, message = '操作成功', status = 200) => ({
  success: true,
  data,
  message,
  timestamp: new Date().toISOString(),
  status
})

/**
 * 错误响应
 * @param {string} code - 错误码
 * @param {string} message - 错误消息
 * @param {number} status - HTTP状态码
 * @param {*} details - 详细错误信息
 * @returns {Object} 错误响应格式
 */
const error = (code, message, status = 500, details = null) => ({
  success: false,
  error: {
    code,
    message,
    details
  },
  timestamp: new Date().toISOString(),
  status
})

/**
 * 分页处理工具
 * @param {Array} data - 原始数据数组
 * @param {number} page - 页码
 * @param {number} limit - 每页条数
 * @returns {Object} 分页结果
 */
const paginate = (data, page = 1, limit = 10) => {
  const pageNum = parseInt(page)
  const limitNum = parseInt(limit)
  const offset = (pageNum - 1) * limitNum
  
  const items = data.slice(offset, offset + limitNum)
  const total = data.length
  const totalPages = Math.ceil(total / limitNum)
  
  return {
    items,
    total,
    page: pageNum,
    limit: limitNum,
    totalPages,
    hasNext: pageNum < totalPages,
    hasPrev: pageNum > 1
  }
}

/**
 * 格式化时间
 * @param {Date|string} date - 日期对象或字符串
 * @param {string} format - 格式化模式
 * @returns {string} 格式化后的时间字符串
 */
const formatTime = (date = new Date(), format = 'yyyy-MM-dd HH:mm:ss') => {
  const d = new Date(date)
  const year = d.getFullYear()
  const month = String(d.getMonth() + 1).padStart(2, '0')
  const day = String(d.getDate()).padStart(2, '0')
  const hours = String(d.getHours()).padStart(2, '0')
  const minutes = String(d.getMinutes()).padStart(2, '0')
  const seconds = String(d.getSeconds()).padStart(2, '0')
  
  return format
    .replace('yyyy', year)
    .replace('MM', month)
    .replace('dd', day)
    .replace('HH', hours)
    .replace('mm', minutes)
    .replace('ss', seconds)
}

/**
 * 延迟响应（用于模拟网络延迟）
 * @param {Function} responseFn - 响应函数
 * @param {number} delay - 延迟时间（毫秒）
 * @returns {Promise} 延迟响应Promise
 */
const delayResponse = (responseFn, delay = 500) => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve(responseFn())
    }, delay)
  })
}

module.exports = {
  success,
  error,
  paginate,
  formatTime,
  delayResponse
}
```

