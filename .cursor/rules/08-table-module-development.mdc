    width: 80,
    fixed: 'left'
  },
  {
    prop: 'name',
    label: '名称',
    width: 150,
    sortable: true,
    // 支持嵌套属性
    formatter: (row) => row.user?.profile?.name || '-'
  },
  {
    prop: 'status',
    label: '状态',
    width: 100,
    // 使用插槽渲染
    slot: 'column-status'
  },
  {
    prop: 'tags',
    label: '标签',
    width: 200,
    // 自定义渲染函数
    render: (h, { row }) => {
      return h('overflow-tags-popover', {
        props: {
          data: row.tags,
          maxShow: 2,
          title: '标签列表'
        }
      })
    }
  },
  {
    prop: 'actions',
    label: '操作',
    width: 180,
    fixed: 'right',
    slot: 'column-actions'
  }
]
```

## 组件集成规范

### [Module]Table 组件集成
- **强制要求**：新开发的表格组件必须使用BaseTable作为核心表格组件
- 表格组件应集成 TableToolbar、ActionButtons、StatusTag 和 Pagination
- 必须实现列设置功能，支持用户自定义显示列
- 将表格操作逻辑封装在组件内部，通过事件向父组件传递操作
- **性能保障**：自动启用虚拟滚动、防抖优化、错误处理等现代化特性

```vue
<!-- [Module]Table.vue 组件示例 -->
<template>
  <div class="module-table">
    <!-- 工具栏 -->
    <table-toolbar
      :enable-column-settings="true"
      :column-options="columnOptions"
      :storage-key="`${equipmentType}_table_columns`"
      :default-visible-columns="defaultVisibleColumns"
      :enable-batch-actions="true"
      :selected-rows="selectedRows"
      :enable-import="true"
      :import-api="importApi"
      :template-api="templateApi"
      :enable-export="true"
      :export-api="exportApi"
      :export-params="exportParams"
      @refresh="$emit('refresh')"
      @column-change="handleColumnChange"
      @batch-delete="$emit('batch-delete', selectedRows)"
      @batch-enable="$emit('batch-enable', selectedRows)"
      @batch-disable="$emit('batch-disable', selectedRows)"
      @import-success="$emit('import-success', $event)"
      @export-success="$emit('export-success', $event)"
    >
      <template #toolbar-left>
        <el-button type="primary" icon="el-icon-plus" size="mini" @click="$emit('add')">新增</el-button>
      </template>
    </table-toolbar>

    <!-- 数据表格 - 使用BaseTable组件 -->
    <base-table
      :data="data"
      :columns="processedColumns"
      :loading="loading"
      :total="total"
      :current-page.sync="currentPage"
      :page-size.sync="currentLimit"
      :show-pagination="true"
      :virtual-scroll="data.length > 1000"
      :virtual-threshold="1000"
      :virtual-height="400"
      :item-height="40"
      :buffer-size="5"
      :load-error="loadError"
      :allow-retry="true"
      :border="true"
      :stripe="true"
      :show-selection="true"
      @selection-change="handleSelectionChange"
      @sort-change="handleSortChange"
      @pagination="handlePagination"
      @retry="handleRetry"
      @row-click="handleRowClick"
    >
      <!-- 状态列插槽 -->
      <template #column-status="{ row }">
        <status-tag 
          :status="row.status" 
          :text-map="statusTextMap"
          :type-map="statusTypeMap"
        />
      </template>
      
      <!-- 标签列插槽 -->
      <template #column-tags="{ row }">
        <overflow-tags-popover
          :data="row.tags"
          :max-show="2"
          title="标签列表"
        />
      </template>
      
      <!-- 操作列插槽 -->
      <template #column-actions="{ row }">
        <action-buttons
          :buttons="getActionButtons(row)"
          mode="text"
          :row="row"
          @click="handleActionClick"
        />
      </template>
    </base-table>
  </div>
</template>

<script>
import BaseTable from '@/components/BaseTable'
import TableToolbar from '@/components/TableToolbar'
import ActionButtons from '@/components/ActionButtons'
import StatusTag from '@/components/StatusTag'
import OverflowTagsPopover from '@/components/OverflowTagsPopover'

export default {
  name: 'ModuleTable',
  components: {
    BaseTable,
    TableToolbar,
    ActionButtons,
    StatusTag,
    OverflowTagsPopover
  },
  
  props: {
    data: { type: Array, default: () => [] },
    loading: { type: Boolean, default: false },
    total: { type: Number, default: 0 },
    loadError: { type: [String, Object], default: null }
  },
  
  data() {
    return {
      currentPage: 1,
      currentLimit: 20,
      selectedRows: []
    }
  },
  
  computed: {
    // 处理后的列配置
    processedColumns() {
      return [
        {
          prop: 'id',
          label: 'ID',
          width: 80,
          fixed: 'left'
        },
        {
          prop: 'name',
          label: '名称',
          width: 150,
          sortable: true
        },
        {
          prop: 'status',
          label: '状态',
          width: 100,
          slot: 'column-status'
        },
        {
          prop: 'tags',
          label: '标签',
          width: 200,
          slot: 'column-tags'
        },
        {
          prop: 'actions',
          label: '操作',
          width: 180,
          fixed: 'right',
          slot: 'column-actions'
        }
      ]
    }
  },
  
  methods: {
    // 处理选择变更
    handleSelectionChange(selectedRows) {
      this.selectedRows = selectedRows
      this.$emit('selection-change', selectedRows)
    },
    
    // 处理排序变更
    handleSortChange({ column, prop, order }) {
      this.$emit('sort-change', { column, prop, order })
    },
    
    // 处理分页变更
    handlePagination({ page, limit }) {
      this.currentPage = page
      this.currentLimit = limit
      this.$emit('pagination', { page, limit })
    },
    
    // 处理重试
    handleRetry() {
      this.$emit('retry')
    },
    
    // 处理行点击
    handleRowClick(row, column, event) {
      this.$emit('row-click', row, column, event)
    },
    
    // 获取操作按钮
    getActionButtons(row) {
      return [
        { text: '编辑', action: 'edit', type: 'text' },
        { text: '查看', action: 'view', type: 'text' },
        { text: '删除', action: 'delete', type: 'text', class: 'danger' }
      ]
    },
    
    // 处理操作按钮点击
    handleActionClick({ action, row }) {
      this.$emit('action-click', { action, row })
    }
  }
}
</script>
```

