### ActionButtons配置示例
```javascript
// 获取操作按钮配置
getActionButtons(row) {
  // 使用预设按钮生成操作按钮
  const buttons = generateTableButtons(['edit', 'view'])
  
  // 添加状态切换按钮
  const statusButton = {
    text: row.status === 1 ? '禁用' : '启用',
    action: 'statusToggle',
    icon: row.status === 1 ? 'el-icon-close' : 'el-icon-check',
    type: 'text',
    class: row.status === 1 ? 'status-disable' : 'status-enable'
  }
  
  return buttons.concat([statusButton])
}

// 处理按钮点击事件
handleActionClick({ action, row }) {
  switch (action) {
    case 'edit':
      this.$emit('update', row)
      break
    case 'view':
      this.$emit('view', row)
      break
    case 'statusToggle':
      this.$emit('status-change', row)
      break
  }
}
```

## 最佳实践

1. **使用计算属性**：将复杂的表单和表格配置放在计算属性中
2. **模块化API**：将API调用封装在单独的文件中
3. **配置预设**：使用预设配置简化常见操作
4. **TypeScript支持**：为配置项添加TypeScript类型定义
5. **文档完善**：在README.md中记录模块功能、组件说明和注意事项

## 核心原则

1. **统一性**：所有表格模块使用相同的组件结构和交互模式
2. **配置化**：尽量通过配置而非硬编码实现功能
3. **复用性**：充分利用全局组件和预设配置
4. **可维护性**：清晰的结构和足够的文档
5. **用户体验**：一致的交互模式和视觉样式

## 质量检查清单

开发完成后，请检查以下项目是否符合规范：

- [ ] 使用了全局SearchForm组件实现搜索表单
- [ ] 使用了全局TableToolbar组件实现表格工具栏
- [ ] 使用了全局ActionButtons组件实现操作按钮
- [ ] 使用了全局StatusTag组件实现状态显示
- [ ] 使用了全局DrawerForm组件实现表单抽屉
- [ ] 使用了全局Pagination组件实现分页
- [ ] 表单分段清晰，字段归类合理
- [ ] 功能完整：查询、新增、编辑、查看、删除、状态切换
- [ ] 代码符合ESLint规范

## 批量操作规范

### 批量操作消息提示
- **强制要求**：所有批量操作成功后，必须使用统一格式的消息提示
- 批量操作成功后，直接使用后端返回的消息，如果后端没有返回消息，则使用默认消息
- 消息提示应使用以下格式：

```javascript
// 批量操作成功处理
this.$message.success(response.data.message || '批量操作成功')
```

- 其中：
  - `response.data.message`：从API响应中获取的成功消息
  - 如果后端没有返回消息，则使用默认消息作为备选

### 批量操作失败处理
- 批量操作失败时，应提供明确的错误信息
- 错误消息应包含API返回的错误信息，或使用默认错误提示

```javascript
// 批量操作失败处理
this.$message.error(`批量${operationName}失败: ${error.message || '未知错误'}`)
```

### 示例实现
```javascript
// 批量删除示例
handleBatchDelete(rows) {
  if (!rows || rows.length === 0) {
    this.$message.warning('请选择需要删除的记录')
    return
  }
  
  this.$confirm('确认批量删除选中的记录吗？此操作不可恢复', '警告', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning'
  }).then(() => {
    this.listLoading = true
    
    // 获取选中行的ID列表
    const ids = rows.map(row => row.id)
    
    batchDeleteXXX(ids).then(response => {
      this.$message.success(response.data.message || '批量删除成功')
      this.selectedRows = []
      
      // 延迟执行，确保后端处理完成
      setTimeout(() => {
        this.getList()
      }, 300)
    }).catch(error => {
      console.error('批量删除错误:', error)
      this.$message.error(`批量删除失败: ${error.message || '未知错误'}`)
      this.listLoading = false
    })
  }).catch(() => {
    // 取消操作
    this.$message.info('已取消删除操作')
  })
}
```


